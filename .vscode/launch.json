{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django Backend",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "127.0.0.1:8000"],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Run Django Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["test", "tests"],
      "cwd": "${workspaceFolder}/backend"
    }
  ]
}
